# Copy this file to .env and fill in real values. Never commit .env itself.

# Which free provider to use: "groq" or "openrouter"
LLM_PROVIDER=groq

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (https://openrouter.ai/keys) ---
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Path to your repo root. site-agent/ sits inside waleedzafar9.github.io/,
# so this needs to point one level up.
REPO_PATH=..
